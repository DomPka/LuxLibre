{
  "name": "aurora-web-tools",
  "version": "0.5.0",
  "private": true,
  "description": "Build tooling and tests for the Aurora++ v0.5 web pages (control app, firmware flasher)",
  "type": "module",
  "scripts": {
    "build": "node build_flasher.mjs",
    "build:release": "node build_flasher.mjs --require-firmware",
    "build:placeholder": "node build_flasher.mjs --placeholder",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.mjs\"",
    "test:browser": "node browser/run-app-tests.mjs && node browser/run-flasher-tests.mjs",
    "test:all": "npm run typecheck && npm test && npm run test:browser"
  },
  "dependencies": {
    "esptool-js": "0.7.0"
  },
  "devDependencies": {
    "@types/w3c-web-serial": "1.0.8",
    "esbuild": "0.28.2",
    "playwright": "1.56.0",
    "typescript": "5.9.3"
  }
}
